# ========================
# Terraform
# ========================

# Local .terraform directories
**/.terraform/*

# .tfstate files contain sensitive data
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (used for local testing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan output files
*.tfplan

# ========================
# Credentials & Secrets
# ========================
.env
*.pem
*.key

# ========================
# OS / Editor
# ========================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
